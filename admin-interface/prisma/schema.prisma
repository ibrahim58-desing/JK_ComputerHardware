// JK Computer Hardware — Prisma Schema
// MySQL database schema for the e-commerce website

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Admin Users ────────────────────────────────────────────────────────────────

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// ─── Product Categories ─────────────────────────────────────────────────────────

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

// ─── Products ───────────────────────────────────────────────────────────────────

model Product {
  id               Int            @id @default(autoincrement())
  name             String         @db.VarChar(255)
  slug             String         @unique @db.VarChar(255)
  description      String         @default("") @db.Text
  shortDescription String         @default("") @map("short_description") @db.Text
  price            String         @default("₹0")
  numericPrice     Float          @default(0) @map("numeric_price")
  originalPrice    String?        @map("original_price")
  stock            Int            @default(0)
  brand            String         @default("")
  specs            Json           @default("[]")
  badge            Json?
  offer            String?
  image            String         @default("/placeholder.jpg")
  featured         Boolean        @default(false)
  status           String         @default("active") // active | inactive
  categoryId       Int            @map("category_id")
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  enquiries        Enquiry[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@index([numericPrice])
  @@index([brand])
  @@index([status, categoryId, createdAt])
  @@index([status, brand])
  @@map("products")
}

// ─── Product Images ─────────────────────────────────────────────────────────────

model ProductImage {
  id           Int     @id @default(autoincrement())
  productId    Int     @map("product_id")
  imageUrl     String  @map("image_url")
  displayOrder Int     @default(0) @map("display_order")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── Customer Enquiries ─────────────────────────────────────────────────────────

model Enquiry {
  id           Int      @id @default(autoincrement())
  customerName String   @map("customer_name") @db.VarChar(255)
  phone        String   @default("")
  email        String   @default("") @db.VarChar(255)
  subject      String   @default("") @db.VarChar(300)
  message      String   @db.Text
  productId    Int?     @map("product_id")
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([productId])
  @@map("enquiries")
}

// ─── Testimonials ───────────────────────────────────────────────────────────────

model Testimonial {
  id           Int      @id @default(autoincrement())
  name         String
  role         String   @default("")
  content      String   @db.Text
  rating       Int      @default(5)
  status       String   @default("active") // active | inactive
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("testimonials")
}

// ─── Homepage Comments (public wall, visitor-submitted) ──────────────────────────

model Comment {
  id        Int      @id @default(autoincrement())
  name      String
  message   String   @db.Text
  status    String   @default("active") // active | hidden
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("comments")
}

// ─── Site Settings ──────────────────────────────────────────────────────────────

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("") @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
