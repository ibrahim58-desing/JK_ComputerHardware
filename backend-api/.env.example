# Database
DATABASE_URL="postgresql://jk_user:your_password@localhost:5432/jk_computers?connection_limit=10&pool_timeout=10"

# JWT (minimum 32 characters in production)
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_ISSUER="jk-computers"
JWT_AUDIENCE="jk-admin"
ADMIN_ACCESS_TOKEN_EXPIRY="20m"
ADMIN_REFRESH_TOKEN_EXPIRY="7d"

# Upload
UPLOAD_MAX_SIZE_MB=5

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Must match user-interface's REVALIDATE_SECRET exactly — lets this app tell
# user-interface to drop its cached settings right after an admin save.
REVALIDATE_SECRET="change-this-to-a-secure-random-string"
